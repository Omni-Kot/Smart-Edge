<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="12dp">

    <!-- Edit Icon (Pencil) - Subtle Circular Background -->
    <ImageView
        android:id="@+id/ivAddIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_close_btn"
        android:backgroundTint="#4DFFFFFF"
        android:contentDescription="@string/ui_edit_apps"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_edit"
        app:tint="#FFFFFF" />

    <!-- Edit Label -->
    <TextView
        android:id="@+id/tvEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/ui_edit_variant"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

</LinearLayout>
